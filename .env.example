# ==============================================================================
# SNode.C SSO & MFA - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and modify it as needed. Since SNode.C is written in
# C++, these variables should be sourced in your shell or passed to the binary:
#
# Usage (Shell sourcing):
#   set -a && source .env && set +a
#   ./build/src/apps/auth_idp/auth_idp
#
# Usage (Inline run):
#   DB_PATH="snodec_auth.db" IDP_PORT="8083" ./build/src/apps/auth_idp/auth_idp
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Identity Provider (IdP) Configurations
# ------------------------------------------------------------------------------

# The port on which the IdP server will listen.
# Default: 8083
IDP_PORT=8083

# The external base URL of the IdP. Used in OAuth2 redirection.
# Default: http://localhost:8083
IDP_BASE_URL=http://localhost:8083

# The JWT Issuer identifier claim (iss). Used in JWT generation & verification.
# Default: https://idp.snodec.local
IDP_ISSUER=https://idp.snodec.local

# Path to the SQLite database file.
# Default: snodec_auth.db
DB_PATH=snodec_auth.db

# Path to the PEM-encoded RS256 private key file for signing JWTs.
# Default: src/apps/auth_idp/keys/private_key.pem
IDP_PRIVATE_KEY_PATH=src/apps/auth_idp/keys/private_key.pem

# Path to the 256-bit symmetric encryption key file for AES-256-GCM.
# If empty, TOTP secrets will be stored in the database in plain hex (Development/Dev Mode).
# If configured, it will read/generate a 32-byte key file to encrypt secrets at rest.
# Default: (Empty)
TOTP_KEY_PATH=keys/totp.key

# Comma-separated list of allowed OAuth2 redirect URIs.
# Default: (Empty, allowing http://localhost:8055/auth/callback by default)
IDP_ALLOWED_REDIRECT_URIS=http://localhost:8055/auth/callback,http://192.168.1.1:8055/auth/callback

# SMTP delivery command to send password reset links.
# If empty/unset, password reset links are printed to stdout and shown in the browser (LAN local mode).
# If set, the plain-text email is piped directly to the command's stdin.
# Example: "msmtp user@example.com" or "sendmail -t"
# Default: (Empty)
SMTP_COMMAND=

# ------------------------------------------------------------------------------
# 2. Relying Party (Protected WebApp) Configurations
# ------------------------------------------------------------------------------

# The port on which the Protected WebApp will listen.
# Default: 8055
WEBAPP_PORT=8055

# The Client ID registered at the IdP.
# Default: snodec-webapp
WEBAPP_CLIENT_ID=snodec-webapp

# Whether HTTPS is enabled (Secure Cookies).
# If set to "true", cookies (pkce_verifier, access_token) will contain the "; Secure" flag.
# Note: Enabling this requires the application to be accessed over HTTPS (SSL/TLS).
# Default: false
HTTPS_ENABLED=false
